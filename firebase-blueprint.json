{
  "entities": {
    "Family": {
      "title": "Family",
      "description": "Root family account owned by a parent user, supporting up to 10 connected child devices.",
      "type": "object",
      "properties": {
        "parentUid": { "type": "string", "description": "Authenticated parent Google UID" },
        "parentName": { "type": "string", "description": "Display name of parent guardian" },
        "parentEmail": { "type": "string", "description": "Parent email (PII, owner-only)" },
        "maxDevices": { "type": "integer", "description": "Maximum allowed child devices (10)" },
        "deviceCount": { "type": "integer", "description": "Current number of paired child devices" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["parentUid", "parentName", "maxDevices", "deviceCount", "createdAt", "updatedAt"]
    },
    "PairingCode": {
      "title": "PairingCode",
      "description": "One-time expiring pairing code generated by the parent to link a child device.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "6-12 char uppercase pairing code" },
        "familyId": { "type": "string", "description": "Target family ID (parentUid)" },
        "parentUid": { "type": "string", "description": "Creator parent UID" },
        "deviceLabel": { "type": "string", "description": "Friendly label for the child device" },
        "status": { "type": "string", "enum": ["pending", "claimed", "revoked"] },
        "claimedByUid": { "type": "string", "description": "Child UID that claimed this code" },
        "claimedDeviceId": { "type": "string", "description": "Created device document ID" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "familyId", "parentUid", "deviceLabel", "status", "expiresAt", "createdAt", "updatedAt"]
    },
    "ChildDevice": {
      "title": "ChildDevice",
      "description": "Paired child device profile, telemetry, screen-time stats, and consent flags.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "parentUid": { "type": "string" },
        "childUid": { "type": "string" },
        "deviceName": { "type": "string" },
        "deviceModel": { "type": "string" },
        "osVersion": { "type": "string" },
        "pairingCode": { "type": "string" },
        "batteryLevel": { "type": "integer" },
        "isCharging": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "locationConsentEnabled": { "type": "boolean" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "locationLabel": { "type": "string" },
        "dailyScreenTimeMinutes": { "type": "integer" },
        "screenTimeLimitMinutes": { "type": "integer" },
        "appUsageSummary": { "type": "array" },
        "activeSessionType": { "type": "string", "enum": ["none", "camera", "microphone", "screen"] },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "familyId", "parentUid", "childUid", "deviceName", "deviceModel", "osVersion",
        "pairingCode", "batteryLevel", "isCharging", "isOnline", "locationConsentEnabled",
        "dailyScreenTimeMinutes", "screenTimeLimitMinutes", "appUsageSummary",
        "activeSessionType", "lastActiveAt", "createdAt", "updatedAt"
      ]
    },
    "PairedLink": {
      "title": "PairedLink",
      "description": "User-scoped bookmark linking a child Google account to its paired family and device ID.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "familyId": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "parentName": { "type": "string" },
        "role": { "type": "string", "enum": ["parent", "child"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "familyId", "deviceId", "deviceName", "parentName", "role", "createdAt", "updatedAt"]
    },
    "MonitoringSession": {
      "title": "MonitoringSession",
      "description": "Consent-gated live WebRTC camera, microphone, or screen mirroring session with expiration.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "parentUid": { "type": "string" },
        "childUid": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "sessionType": { "type": "string", "enum": ["camera", "microphone", "screen"] },
        "status": { "type": "string", "enum": ["requested", "active", "declined", "ended", "expired"] },
        "encryptionFingerprint": { "type": "string" },
        "sdpOffer": { "type": "string" },
        "sdpAnswer": { "type": "string" },
        "iceCandidates": { "type": "array" },
        "previewFrameBase64": { "type": "string" },
        "audioLevelDb": { "type": "integer" },
        "requestedDurationMinutes": { "type": "integer" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "endedReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "familyId", "parentUid", "childUid", "deviceId", "deviceName", "sessionType",
        "status", "encryptionFingerprint", "iceCandidates", "audioLevelDb",
        "requestedDurationMinutes", "expiresAt", "createdAt", "updatedAt"
      ]
    },
    "SharedFile": {
      "title": "SharedFile",
      "description": "Permission-based file entry shared via Android Photo Picker or Storage Access Framework.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "parentUid": { "type": "string" },
        "childUid": { "type": "string" },
        "deviceId": { "type": "string" },
        "uploadedByUid": { "type": "string" },
        "uploaderRole": { "type": "string", "enum": ["parent", "child"] },
        "fileName": { "type": "string" },
        "mimeType": { "type": "string" },
        "sizeBytes": { "type": "integer" },
        "category": { "type": "string", "enum": ["photo", "video", "document"] },
        "consentGranted": { "type": "boolean" },
        "thumbnailBase64": { "type": "string" },
        "textPreview": { "type": "string" },
        "localUriString": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "familyId", "parentUid", "childUid", "deviceId", "uploadedByUid",
        "uploaderRole", "fileName", "mimeType", "sizeBytes", "category",
        "consentGranted", "createdAt", "updatedAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only immutable audit log entry for every monitoring and pairing event.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorRole": { "type": "string", "enum": ["parent", "child", "system"] },
        "childUid": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "eventType": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "actorUid", "actorRole", "childUid", "deviceId", "deviceName", "eventType", "details", "createdAt"]
    }
  },
  "firestore": {
    "/families/{familyId}": {
      "schema": { "$ref": "#/entities/Family" },
      "description": "Family root document owned by the parent user"
    },
    "/pairing_codes/{code}": {
      "schema": { "$ref": "#/entities/PairingCode" },
      "description": "Temporary pairing codes for linking up to 10 child devices"
    },
    "/families/{familyId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/ChildDevice" },
      "description": "Paired child devices under a parent family"
    },
    "/users/{userId}/paired_links/{linkId}": {
      "schema": { "$ref": "#/entities/PairedLink" },
      "description": "Private user bookmarks of paired family device bindings"
    },
    "/families/{familyId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/MonitoringSession" },
      "description": "Consent-gated live camera, mic, and screen-sharing sessions with WebRTC signaling"
    },
    "/families/{familyId}/shared_files/{fileId}": {
      "schema": { "$ref": "#/entities/SharedFile" },
      "description": "Authorized SAF and Photo Picker files shared between parent and child"
    },
    "/families/{familyId}/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable append-only audit trail for all monitoring events"
    }
  }
}
